#!/usr/bin/env bash
# Crochet git tracké dans le dépôt (2026-09-19) — jamais posé seulement dans .git/hooks/ (local,
# jamais commité, disparaîtrait au prochain clone). Installé automatiquement par le script
# "prepare" de package.json (node scripts/hooks/install.mjs), qui pointe git dessus via
# `core.hooksPath` à chaque `pnpm install` — donc actif sur tout clone frais, jamais une
# configuration à refaire à la main. N'échoue jamais le commit lui-même (avertit sans bloquer,
# décision explicite de l'utilisateur) : un post-commit ne le pourrait de toute façon pas, ce qui
# correspond exactement à ce choix.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
# LA BANNIÈRE EST HIÉRARCHISÉE DEPUIS LE 2026-09-26 (tâche #798). Chaque outil passe par un
# enrobage qui n'affiche que ce qui EXIGE UNE ACTION et range le reste dans un journal local relu
# à la demande. Mesuré : 365 lignes à chaque commit, ignorées sept fois de suite, ramenées à 9.
# RIEN N'EST SUPPRIMÉ — chaque bloc avait été ajouté parce qu'un défaut réel était passé inaperçu.
# BANNIERE_PREMIER=1 sur le premier appel seulement : il ÉCRASE le journal, les suivants le
# complètent, si bien qu'on lit toujours la bannière du DERNIER commit et jamais l'accumulation.
BANNIERE_PREMIER=1 node scripts/hooks/banniere.mjs node scripts/hooks/check-last-commit.mjs || true
# ecotoken (2026-09-22) — alerte NON BLOQUANTE sur le poids de CLAUDE.md, le seul
# document rechargé à chaque message. Choix explicite de l'utilisateur : une alerte, jamais un
# blocage — ajouter une vraie règle importante en pleine session doit rester possible, on veut
# seulement que ça ne se fasse plus sans le savoir. La charte a déjà maigri deux fois et regrossi
# les deux fois : sans ce rappel au moment du commit, on ne s'en aperçoit qu'à la Ronde suivante.
node scripts/hooks/banniere.mjs node scripts/ecotoken.mjs budget || true
# MOÏSE-TABLES-DE-LOI (2026-09-23, tâche #613) — alerte NON BLOQUANTE de FRAÎCHEUR des instruments
# de la charte, calibrage explicite de l'utilisateur : « une alerte gratuite à chaque commit, le
# reste sur demande ». Distincte de la ligne ecotoken ci-dessus, qui surveille le POIDS : celle-ci
# surveille si les instruments SERVANT À DÉCIDER sont encore à jour. Le défaut qu'elle ferme est
# constaté, pas craint : la table de classification servant à décider quoi alléger a tourné trois
# jours en ignorant six Articles, et un instrument périmé ne rend pas une erreur — il rend des
# chiffres qui ont l'air justes.
node scripts/hooks/banniere.mjs node scripts/moise-tables-de-loi.mjs || true

# LA CHARTE SE PROTÈGE ELLE-MÊME (2026-09-23, tâche #631) — uniquement quand elle a bougé, pour
# qu'un commit qui ne la touche pas reste silencieux : un contrôle qui parle pour rien cesse d'être lu.
if git diff --name-only HEAD~1 HEAD 2>/dev/null | grep -qx "CLAUDE.md"; then
  node scripts/hooks/banniere.mjs node scripts/moise-tables-de-loi.mjs protection || true
fi

# LA DETTE DOCUMENTAIRE, SIGNALÉE À SA NAISSANCE (2026-09-25, tâche #436 partie 2) — alerte NON
# BLOQUANTE, même calibrage que les lignes ci-dessus.
#
# LE DÉFAUT QU'ELLE FERME EST MESURÉ, jamais craint : god-of-all-process détecte depuis le
# 2026-09-23 le code d'un process modifié sans son document, et il ne tournait QUE lancé à la main.
# Neuf dettes s'étaient accumulées le 2026-09-25 — sept payées en retard, deux encore dues. Aucune
# n'était cachée : regarder demandait un geste, et un geste qu'on doit penser à faire finit par ne
# plus être fait (leçon L2 : un mécanisme qui ne sort pas du script est une intention).
#
# LE FILTRE EST UN SUPERSET VOLONTAIRE : on lance dès qu'un script a bougé, jamais une liste des
# scripts de process recopiée ici. Une liste dans le crochet divergerait en silence du jour où un
# process change de contrôleur (Article 24) ; la précision vit dans l'outil, qui est muet quand il
# n'a rien trouvé.
if git diff --name-only HEAD~1 HEAD 2>/dev/null | grep -qE '^scripts/.*\.mjs$'; then
  node scripts/hooks/banniere.mjs node scripts/god-of-all-process.mjs dette || true
fi

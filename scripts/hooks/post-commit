#!/usr/bin/env bash
# Crochet git tracké dans le dépôt (2026-09-19) — jamais posé seulement dans .git/hooks/ (local,
# jamais commité, disparaîtrait au prochain clone). Installé automatiquement par le script
# "prepare" de package.json (node scripts/hooks/install.mjs), qui pointe git dessus via
# `core.hooksPath` à chaque `pnpm install` — donc actif sur tout clone frais, jamais une
# configuration à refaire à la main. N'échoue jamais le commit lui-même (avertit sans bloquer,
# décision explicite de l'utilisateur) : un post-commit ne le pourrait de toute façon pas, ce qui
# correspond exactement à ce choix.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
node scripts/hooks/check-last-commit.mjs || true
# ecotoken (2026-09-22) — alerte NON BLOQUANTE sur le poids de CLAUDE.md, le seul
# document rechargé à chaque message. Choix explicite de l'utilisateur : une alerte, jamais un
# blocage — ajouter une vraie règle importante en pleine session doit rester possible, on veut
# seulement que ça ne se fasse plus sans le savoir. La charte a déjà maigri deux fois et regrossi
# les deux fois : sans ce rappel au moment du commit, on ne s'en aperçoit qu'à la Ronde suivante.
node scripts/ecotoken.mjs budget || true
# MOÏSE-TABLES-DE-LOI (2026-09-23, tâche #613) — alerte NON BLOQUANTE de FRAÎCHEUR des instruments
# de la charte, calibrage explicite de l'utilisateur : « une alerte gratuite à chaque commit, le
# reste sur demande ». Distincte de la ligne ecotoken ci-dessus, qui surveille le POIDS : celle-ci
# surveille si les instruments SERVANT À DÉCIDER sont encore à jour. Le défaut qu'elle ferme est
# constaté, pas craint : la table de classification servant à décider quoi alléger a tourné trois
# jours en ignorant six Articles, et un instrument périmé ne rend pas une erreur — il rend des
# chiffres qui ont l'air justes.
node scripts/moise-tables-de-loi.mjs || true

# LA CHARTE SE PROTÈGE ELLE-MÊME (2026-09-23, tâche #631) — uniquement quand elle a bougé, pour
# qu'un commit qui ne la touche pas reste silencieux : un contrôle qui parle pour rien cesse d'être lu.
if git diff --name-only HEAD~1 HEAD 2>/dev/null | grep -qx "CLAUDE.md"; then
  node scripts/moise-tables-de-loi.mjs protection || true
fi
